<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuantumBridge</AssemblyName>
    <RootNamespace>JblQuantumBridge</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Prefer real Quantum Engine for local builds; fall back to stubs for CI. -->
    <QuantumEnginePath Condition="'$(QuantumEnginePath)' == ''">C:\Program Files\JBL\QuantumENGINE</QuantumEnginePath>
    <UseQuantumStubs Condition="'$(UseQuantumStubs)' == '' and !Exists('$(QuantumEnginePath)\QuantumServer.dll')">true</UseQuantumStubs>
    <QuantumServerDll Condition="'$(UseQuantumStubs)' != 'true'">$(QuantumEnginePath)\QuantumServer.dll</QuantumServerDll>
    <QuantumServerDll Condition="'$(UseQuantumStubs)' == 'true'">$(MSBuildThisFileDirectory)stubs\bin\$(Configuration)\net8.0\QuantumServer.dll</QuantumServerDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="QuantumServer">
      <HintPath>$(QuantumServerDll)</HintPath>
      <Private>false</Private>
      <CopyLocal>false</CopyLocal>
    </Reference>
  </ItemGroup>

  <Target Name="BuildQuantumStubs" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseQuantumStubs)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)stubs\QuantumServer.Stubs.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
